# HMS API environment (copy to server ~/stacks/hms.env, chmod 600)
HOST=0.0.0.0
PORT=3000
APP_VERSION=1.3.0

DB_HOST=postgres
DB_PORT=5432
DB_NAME=hms
DB_USER=hms_user
DB_PASS=change-me

JWT_SECRET=change-me-long-random
UPLOAD_DIR=/data/uploads

# Public origin of the app (used for push VAPID subject + telegram link buttons)
PUBLIC_URL=

# Telegram parent notifications (optional)
TELEGRAM_BOT_TOKEN=
# secret for webhook callbacks (inline approve buttons); set the webhook with setWebhook
TELEGRAM_WEBHOOK_SECRET=

# Ops bridge (remote notify + decision channel). OPS_TOKEN authorizes /api/ops/*.
# OPS_CHAT_ID is the owner's chat with the bot (target for ops messages).
OPS_TOKEN=
OPS_CHAT_ID=

# Gemini AI chat (v1.20.0). 키는 Google AI Studio 에서 발급한다.
# GEMINI_MODELS 는 시도 순서 - 앞 모델이 무료 한도(429)에 걸리면 다음 모델로 넘어간다.
# 백업 키를 넣으면 모델을 다 쓴 뒤 그 키로 한 바퀴 더 돈다 (프로젝트별 한도가 따로 잡힘).
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=30000
